<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Worker-95a49843-f1cc-497e-8a0d-84a1431d5961</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.12" />
    <!-- 显式对齐 EF Core 版本，避免 MassTransit 传递引用的 10.0.4 与 Sagas 的 10.0.15 冲突（MSB3277） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MassTransitSaga.Contracts\MassTransitSaga.Contracts.csproj" />
    <ProjectReference Include="..\MassTransitSaga.Sagas\MassTransitSaga.Sagas.csproj" />
  </ItemGroup>

</Project>
